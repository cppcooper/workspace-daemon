[Unit]
Description=Workspace creation and process supervision
Requires=workspace-daemon.socket
After=workspace-daemon.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/workspace-daemon --config %h/.config/workspace-daemon/config.json
Environment=PATH=/usr/bin:/bin
UMask=0077
Slice=paperclip.slice
MemoryMax=512M
MemorySwapMax=0
CPUQuota=50%
TasksMax=128
NoNewPrivileges=yes
# A failed compiler/worker must not make systemd stop a healthy control process.
# The service still has its existing hard memory limit and process supervision.
OOMPolicy=continue
# The daemon applies read-only filesystem protection inside its own namespace
# after validating original host ownership. systemd's corresponding user-unit
# options create an earlier UID mapping that hides root ownership.
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
